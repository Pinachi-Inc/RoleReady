# Copy to .env and fill in. Never commit real values.

# --- Model (OpenAI-compatible API, e.g. OpenRouter) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=RoleBerry
MODEL_PROVIDERS=

# --- AI detection ---
SAPLING_API_KEY=

# --- Firebase (client, bundled into the SPA) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (server) ---
# Service account JSON, raw or base64. Required for quotas, history and billing.
FIREBASE_SERVICE_ACCOUNT=
# Defaults to VITE_FIREBASE_PROJECT_ID when unset.
FIREBASE_PROJECT_ID=

# --- Billing ---
# Stripe secret key (sk_test_... locally, sk_live_... in production).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint that points at /api/stripe-webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# The $12/month recurring price (price_...).
STRIPE_PRICE_ID=
# Where Stripe sends the browser back to. Defaults to the request's origin.
APP_URL=
# true = refuse optimizations over the plan limit. Off = count usage but allow everything.
BILLING_ENFORCED=false
# Comped accounts with full access and no payment, comma-separated.
UNLIMITED_EMAILS=
UNLIMITED_UIDS=

# --- Server ---
PORT=8787
# Cross-origin callers allowed to hit the API, comma-separated. Empty = same-origin only.
ALLOWED_ORIGINS=
