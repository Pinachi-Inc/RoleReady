# Copy to .env and fill in. Never commit real values.

# --- Model (OpenAI-compatible API, e.g. OpenRouter) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=RoleBerry
MODEL_PROVIDERS=

# --- Firebase (client, bundled into the SPA) ---
VITE_FIREBASE_API_KEY=
# Production: roleberry.app. vercel.json proxies /__/auth/* to the project's firebaseapp.com
# domain, so Google and GitHub sign-in show roleberry.app instead of roleready-d7295.firebaseapp.com.
# Elsewhere (local, previews): <project-id>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (server) ---
# Service account JSON, raw or base64. Required for quotas, history and billing.
FIREBASE_SERVICE_ACCOUNT=
# Defaults to VITE_FIREBASE_PROJECT_ID when unset.
FIREBASE_PROJECT_ID=

# --- Billing (Polar, merchant of record) ---
# Organization access token (Polar > Settings > Developers). A sandbox token needs POLAR_SERVER=sandbox.
POLAR_ACCESS_TOKEN=
# 'sandbox' or 'production' (default production).
POLAR_SERVER=
# Product ids of the $12/month Pro and $49/month Max products.
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_MAX=
# Secret of the webhook that points at /api/polar-webhook.
POLAR_WEBHOOK_SECRET=
# Max's fair-use ceiling, optimizations per calendar month. Default 5000.
MAX_MONTHLY_RUNS=
# Where checkout sends the browser back to. Defaults to the request's origin.
APP_URL=
# true = refuse optimizations over the plan limit. Off = count usage but allow everything.
BILLING_ENFORCED=false
# Complimentary Max with no payment, by sign-in email, comma-separated, case-insensitive.
# Same limits as paid Max, fair-use cap included. To grant one account at a time without a
# redeploy, use the admin script instead: npm run comp -- grant|revoke <email> | list
COMP_MAX_EMAILS=
# Older names for the same allowlist, still honoured.
UNLIMITED_EMAILS=
UNLIMITED_UIDS=

# --- Feedback and problem reports ---
# Brevo API key (Brevo, SMTP and API, API Keys; not the SMTP key). Unset = reports are stored
# in Firestore (collection `feedback`) but not emailed.
BREVO_API_KEY=
# Where reports are emailed, and the sender they come from. Both default to support@roleberry.app.
# The sender's domain must be authenticated in Brevo.
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
# Any long random string. Salts the hashed IPs used for rate limiting.
FEEDBACK_IP_SALT=

# --- Account emails (welcome, first-run reminder, out of free runs, cancel feedback) ---
# On automatically in Vercel Production. true forces them on anywhere; false turns them off in Production.
LIFECYCLE_EMAILS_ENABLED=
# Any long random string. Signs unsubscribe links. Required for these emails to send.
EMAIL_LINK_SECRET=
# Any long random string. Vercel cron sends it as a Bearer token to /api/email?action=nudge.
CRON_SECRET=
# Sender address. Defaults to hello@roleberry.app (domain authenticated in Brevo). Replies go to support@.
LIFECYCLE_FROM_EMAIL=

# --- Server ---
PORT=8787
# Cross-origin callers allowed to hit the API, comma-separated. Empty = same-origin only.
ALLOWED_ORIGINS=
