{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/optimize.js": {
      "maxDuration": 300,
      "memory": 1536
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
