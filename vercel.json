{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "gh-readonly-queue/**": false
    }
  },
  "functions": {
    "api/optimize.js": {
      "maxDuration": 300,
      "memory": 1536
    },
    "api/process-pdf.js": {
      "maxDuration": 300,
      "memory": 1536
    },
    "api/feedback.js": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
